__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
configs/models.json

# LaTeX build products. acmart.cls is generated from the vendored
# acmart.ins and acmart.dtx by paper/Makefile, so the sources are
# committed and the derived class is not.
paper/acmart.cls
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Rendered animations are derived from committed scenarios and committed
# code, weigh about a megabyte each, and their bytes move with the
# matplotlib version. They are committed deliberately at milestones rather
# than on every regeneration. See docs/img/README.md.
docs/img/*.gif
# Two exceptions, both committed deliberately and regenerated only when the
# figure they illustrate changes: the animation this README shows, and the
# banner-width one published on the profile page.
!docs/img/keep_out_shortcut.gif
!docs/img/pillar_aisle.gif

# LaTeX build artefacts; the PDF is committed at milestones only.
paper/*.aux
