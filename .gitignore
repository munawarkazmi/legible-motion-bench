__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
configs/models.json

# Rendered animations are derived from committed scenarios and committed
# code, weigh about a megabyte each, and their bytes move with the
# matplotlib version. They are committed deliberately at milestones rather
# than on every regeneration. See docs/img/README.md.
docs/img/*.gif

# LaTeX build artefacts; the PDF is committed at milestones only.
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.run.xml
